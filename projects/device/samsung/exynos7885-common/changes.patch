--- a/configs/init/init.samsung.rc
+++ b/configs/init/init.samsung.rc
@@ -96,6 +96,12 @@ on post-fs-data
     mkdir /efs/nfc 0700 nfc nfc
 
 on boot
+    # Start the power HAL boost worker (it waits for this property); without it no boosts run
+    setprop vendor.powerhal.init 1
+    # Memory speed floor: owned by system:radio with no group write, so the power HAL (uid 0, gid system) cannot open it
+    chown system system /sys/devices/platform/17000010.devfreq_mif/devfreq/17000010.devfreq_mif/scaling_devfreq_min
+    chmod 0664 /sys/devices/platform/17000010.devfreq_mif/devfreq/17000010.devfreq_mif/scaling_devfreq_min
+
     # MSP: FactoryApp directory generation
     mkdir /efs/FactoryApp 0775 system system
 
@@ -549,3 +555,4 @@ on charger
 # BATTERY
 on property:sys.boot_completed=1
     write /sys/class/power_supply/battery/boot_completed "1"
+    write /sys/class/sec/tsp/cmd set_grip_data,1,0,0,0,0
