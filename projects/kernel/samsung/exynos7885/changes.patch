new mode 100644
index 105310afef2ab3f975d4c3e3270b2f575abd2ecb..2b0a78ccb1934087b88e1a47ab7fbb5b2a83db42
--- a/drivers/usb/gadget/configfs.c
+++ b/drivers/usb/gadget/configfs.c
@@ -773,12 +773,26 @@ static int config_usb_cfg_link(
 		goto out;
 	}
 
-#ifdef CONFIG_USB_CONFIGFS_UEVENT
-	list_add_tail(&f->list, &gi->linked_func);
-#else
-	/* stash the function until we bind it to the gadget */
-	list_add_tail(&f->list, &cfg->func_list);
-#endif
+	/* first-link-fix v3 (26 Oct): v2 added straight into cfg->func_list
+	 * unconditionally on every call, which also fired on later, real
+	 * USB mode switches after a function was already linked here -
+	 * confirmed to corrupt a kernel list and crash (kfree() BUG plus a
+	 * second, unrelated cgroup_file_release NULL deref moments later,
+	 * the classic signature of heap corruption caused upstream of
+	 * where it actually crashes; found by reading /proc/last_kmsg
+	 * after the real crash, not guessed).
+	 * Guard it on whether this config has ever had anything linked
+	 * into it: an empty cfg->func_list means this is a genuine
+	 * first-ever link (recovery's one-shot boot case the fix is for),
+	 * which is safe to add straight in. Anything already linked means
+	 * this is a later re-link (real mode switching on a live system),
+	 * which must go through the kernel's own original GSI holding-list
+	 * path instead - the one every build before this fix already used
+	 * without ever corrupting anything. */
+	if (list_empty(&cfg->func_list))
+		list_add_tail(&f->list, &cfg->func_list);
+	else
+		list_add_tail(&f->list, &gi->linked_func);
 	ret = 0;
 out:
 	mutex_unlock(&gi->lock);
